{
  "manifest_version": 3,
  "name": "Google Calendar ゲスト入力ヘルパー",
  "version": "1.0.0",
  "description": "Googleカレンダーのゲスト入力を支援するChrome拡張機能。階層グループ管理、一括設定、ゲストアドレスコピー機能を搭載。",
  "permissions": [
    "storage",
    "activeTab",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://calendar.google.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ゲスト入力ヘルパー"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://calendar.google.com/*"],
      "js": ["content.js"]
    }
  ]
}