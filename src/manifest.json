{
  "manifest_version": 3,
  "name": "Tree-Group",
  "version": "1.0.1",
  "description": "Googleの連絡先を階層構造を持ったグループとして管理するための拡張機能。現時点では、カレンダーへのゲストの入力のヘルパーとして機能する。今後はコンタクトをグループとして管理するためにラベル設定などの機能を追加予定。",
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://calendar.google.com/*"
  ],
  "icons": {
    "16": "icons/tree-group.png",
    "32": "icons/tree-group.png",
    "48": "icons/tree-group.png",
    "128": "icons/tree-group.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/tree-group.png",
      "32": "icons/tree-group.png",
      "48": "icons/tree-group.png",
      "128": "icons/tree-group.png"
    },
    "default_popup": "popup.html",
    "default_title": "Tree-Group"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://calendar.google.com/*"],
      "js": ["content.js"]
    }
  ]
}