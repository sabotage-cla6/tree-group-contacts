{
  "manifest_version": 3,
  "name": "Tree-Group",
  "version": "1.0.0",
  "description": "Googleの連絡先を階層構造を持ったグループとして管理するための拡張機能。現時点では、カレンダーへのゲストの入力のヘルパーとして機能する。今後はコンタクトをグループとして管理するためにラベル設定などの機能を追加予定。",
  "permissions": [
    "storage",
    "activeTab",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://calendar.google.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tree-Group"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://calendar.google.com/*"],
      "js": ["content.js"]
    }
  ]
}